# Copy to .env and adjust for your machine.
# Used by docker-compose.yml.

POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard

# Change this to a long random value anywhere it is not purely local.
JWT_SECRET=dev-only-change-me

# Base URL the browser uses to reach the API (used by the web service).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Origin the API allows from the browser (used by the api service). Must match
# the origin the web app is served from.
CORS_ORIGIN=http://localhost:3000
